     <rdf:li>wapensysteem</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Schieten op drones in Duitsland</rdf:li>
    </rdf:Alt>
   </dc:title>
