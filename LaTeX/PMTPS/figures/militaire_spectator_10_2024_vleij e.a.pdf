   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Bergen-Hohne, 29 februari 2024 42 Pantserinfanteriebataljon gaat met eigen wapensystemen op dreigingen vanuit de lucht schieten. Drones in dit geval.</rdf:li>
    </rdf:Alt>
   </dc:description>
