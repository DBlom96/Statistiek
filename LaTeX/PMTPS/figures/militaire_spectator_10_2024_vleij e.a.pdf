   <dc:creator>
    <rdf:Seq>
     <rdf:li>PHIL NIJHUIS</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Vught, 9 mei 2018 - .Defensie beschikt sinds kort over minidrones 'Black Hornet'. Zij zullen door verkenners worden ingezet op patrouilles. Wachtmeesters worden opgeleid tot kerninstructeur. Zij leren in drie dagen vliegen met de Black Hornet en zullen deze kennis uiteindelijk aan hun groep overbrengen.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:publisher>
    <rdf:Bag>
     <rdf:li>Landmacht</rdf:li>
    </rdf:Bag>
   </dc:publisher>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Mediacentrum Defensie (MCD).Info: mcd@mindef.nl.Foto: Phil Nijhuis</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Minidrone</rdf:li>
     <rdf:li>Nano UAV</rdf:li>
     <rdf:li>drone</rdf:li>
     <rdf:li>drones</rdf:li>
     <rdf:li>landmacht</rdf:li>
     <rdf:li>verkenning</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cursus met minidrones Black Hornet</rdf:li>
    </rdf:Alt>
   </dc:title>
