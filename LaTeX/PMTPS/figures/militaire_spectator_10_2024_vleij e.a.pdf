   <dc:creator>
    <rdf:Seq>
     <rdf:li>PHIL NIJHUIS</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Vught, 9 mei 2018 - .Defensie beschikt sinds kort over minidrones 'Black Hornet'. Zij zullen door verkenners worden ingezet op patrouilles. Wachtmeesters worden opgeleid tot kerninstructeur. Zij leren in drie dagen vliegen met de Black Hornet en zullen deze kennis uiteindelijk aan hun groep overbrengen.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:publisher>
    <rdf:Bag>
     <rdf:li>Landmacht</rdf:li>
    </rdf:Bag>
   </dc:publisher>
   <dc:rights>
