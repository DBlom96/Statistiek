% Define base styles using tcolorbox
\tcbuselibrary{skins, breakable}

% Counters
\newcounter{question}
\newcounter{subquestion}[question]

\newcommand{\question}[2]{%
  \stepcounter{question}
  \noindent\textbf{Opdracht #1:} #2\par
}

\newcommand{\enquestion}[2]{%
  \stepcounter{question}
  \noindent\textbf{Exercise #1:} #2\par
}

% Answer visibility toggle
\newif\ifprintanswers
\printanswerstrue % Set to false to hide answers
% \printanswersfalse % Uncomment to hide answers

% Define answer formatting
\newcommand{\answer}[1]{%
  \ifprintanswers
    \begin{tcolorbox}[
      breakable,
      parbox=false,
      colback=blue!5,
      colframe=blue!40,
      title=Uitwerking,
      parskip=\baselineskip,      % ruimte tussen paragrafen binnen de box
      before skip=1em,            % ruimte vóór de box
      after skip=1em              % ruimte ná de box
    ]    
      #1
    \end{tcolorbox}%
  \else
    {}%
  \fi
}

\newcommand{\enanswer}[1]{%
  \ifprintanswers
    \begin{tcolorbox}[
      breakable,
      parbox=false,
      colback=blue!5,
      colframe=blue!40,
      title=Answer,
      parskip=\baselineskip,      % ruimte tussen paragrafen binnen de box
      before skip=1em,            % ruimte vóór de box
      after skip=1em              % ruimte ná de box
    ]    
      #1
    \end{tcolorbox}%
  \else
    {}%
  \fi
}

% Define points formatting
\newcommand{\points}[1]{%
  \ifprintanswers
    \marginnote{\small{(#1pt)}}%
  \else
    {}%
  \fi
}


\renewcommand{\thequestion}{\arabic{question}}
\renewcommand{\thesubquestion}{\thequestion.\alph{subquestion}}

\newcommand{\subquestion}[1]{%
  \stepcounter{subquestion}
  \noindent\textbf{(\thesubquestion)} #1\par
}

% ------------------------------------------------------------------
% 1. DEFINITION BOX (Teal)
% ------------------------------------------------------------------
\newtcolorbox[auto counter, number within=section]{definition}[1][]{
  colback=teal!5!white,
  colframe=teal!75!black,
  fonttitle=\bfseries,
  title=Definition \thetcbcounter\ifstrempty{#1}{}{: #1},
  enhanced,
  attach boxed title to top left={xshift=2mm, yshift=-2mm},
  boxed title style={colback=teal!75!black},
  breakable
}

% ------------------------------------------------------------------
% 2. EXAMPLE BOX (Light Gray/Orange accent)
% ------------------------------------------------------------------
\newtcolorbox[use counter from=definition]{example}[1][]{
  colback=orange!5!white,
  colframe=orange!80!black,
  fonttitle=\bfseries,
  title=Example \thetcbcounter\ifstrempty{#1}{}{: #1},
  enhanced,
  attach boxed title to top left={xshift=2mm, yshift=-2mm},
  boxed title style={colback=orange!80!black},
  breakable
}

% ------------------------------------------------------------------
% 3. THEOREM / HEADER BOX (Deep Blue)
% ------------------------------------------------------------------
\newtcolorbox[use counter from=definition]{theorem}[1][]{
  colback=blue!5!white,
  colframe=blue!75!black,
  fonttitle=\bfseries,
  title=Theorem \thetcbcounter\ifstrempty{#1}{}{: #1},
  enhanced,
  attach boxed title to top left={xshift=2mm, yshift=-2mm},
  boxed title style={colback=blue!75!black},
  breakable
}

% ------------------------------------------------------------------
% 4. COROLLARY BOX (Purple)
% ------------------------------------------------------------------
\newtcolorbox[use counter from=definition]{corollary}[1][]{
  colback=purple!5!white,
  colframe=purple!75!black,
  fonttitle=\bfseries,
  title=Corollary \thetcbcounter\ifstrempty{#1}{}{: #1},
  enhanced,
  attach boxed title to top left={xshift=2mm, yshift=-2mm},
  boxed title style={colback=purple!75!black},
  breakable
}

% ------------------------------------------------------------------
% 4. EXERCISE BOX (Brown)
% ------------------------------------------------------------------
\newtcolorbox{exercise}[1][]{
  colback=brown!5!white,
  colframe=brown!75!black,
  fonttitle=\bfseries,
  title=Exercise,
  enhanced,
  attach boxed title to top left={xshift=2mm, yshift=-2mm},
  boxed title style={colback=brown!75!black},
  breakable
}


% ------------------------------------------------------------------
% 6. PROOF BOX (Minimalist Charcoal Left Border)
% ------------------------------------------------------------------
\newtcolorbox{proofbox}[1][]{
  blanker,
  left=3mm,
  borderline west={2pt}{0pt}{gray!70!black},
  fonttitle=\bfseries,
  title=Proof \ifstrempty{#1}{}{of #1},
  coltitle=gray!70!black,
  space to upper,
  breakable
}

% ------------------------------------------------------------------
% 7. SOLUTION (Greeb Left Border)
% ------------------------------------------------------------------
\newtcolorbox{solution}[1][Solution]{
  blanker,
  left=3mm,
  borderline west={2pt}{0pt}{green!70!black},
  fonttitle=\bfseries,
  title=#1,
  coltitle=green!70!black,
  space to upper,
  breakable
}



