\RequirePackage{../../LaTeX/styles/config}

% Question Environment
\renewenvironment{question}[2] % #1 = points, #2 = question
{%
    \newpage
    \refstepcounter{question}
    \textbf{Opgave \arabic{question} (#1 punten)} {#2}
    \vspace{1ex}
    \begin{itemize}[label={}, left=1.5em, itemsep=1.5em]
}{
    \end{itemize}
}

\renewenvironment{enquestion}[2] % #1 = points, #2 = question
{%
    \newpage
    \refstepcounter{question}
    \textbf{Problem \arabic{question} (#1 points)} {#2}
    \begin{itemize}[label={}, left=1.5em, itemsep=1.5em]
}{
    \end{itemize}
}

% Subquestion Command
\renewenvironment{subquestion}[2]{% #1 = points, #2 = subquestion text
    \refstepcounter{subquestion}
    
    \item[\textbf{\arabic{question}\alph{subquestion} [#1pt]}] {#2}
}
{}

